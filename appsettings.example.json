{
  "FtpMirror": {
    "Interval": "00:02:00",
    "RecentFileWindow": "01:00:00",
    "MaxConcurrentUploads": 5,
    "SourceDirectory": "Z:\\",
    "UserName": "your-sftp-username",
    "Password": "your-sftp-password",
    "Destination": {
      "Host": "your-sftp-host",
      "Port": 22,
      "RootPath": "/remote/root/"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
